# Скопируйте этот файл в .env и при необходимости поправьте под себя.
# По умолчанию всё настроено на запуск на localhost (один ПК).

# Адрес, на котором фронтенд (браузер) будет обращаться к Api_Server
VITE_API_URL=http://5.167.118.31:8080

# Адрес Gateway (WebSocket) для фронтенда
VITE_GATEWAY_WS=ws://5.167.118.31:8081/ws

# Разрешённый CORS-источник на Api_Server (адрес, откуда открывается фронтенд)
CORS_ORIGIN=http://5.167.118.31:5173

# Публичный адрес LiveKit, который Gateway отдаёт браузеру в токене.
# Для доступа из локальной сети/интернета замените на реальный IP/домен,
# например: ws://192.168.1.50:7880 или wss://your-domain.com
LIVEKIT_PUBLIC_URL=ws://5.167.118.31:7880
